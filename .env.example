# Copy to `.env` and fill in real values. Never commit `.env`.
# Variables prefixed NEXT_PUBLIC_ are sent to the browser — never put secrets in them.

# --- Database (Supabase Postgres, >= 15) ---
# Transaction-mode pooler, used by the app at runtime.
DATABASE_URL="postgresql://user:password@host:6543/postgres"
# Session-mode pooler, used for migrations.
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Server-only. Bypasses RLS — used only by server code (analysis pipeline).
SUPABASE_SECRET_KEY="sb_secret_..."

# --- Reading documents ---
# Digital PDFs are always read locally from their built-in text (free).
# OCR_PROVIDER is only used for scans and photos:
#   (empty)  no OCR; scans/photos are rejected with a clear message
#   google   Google Cloud Document AI (needs billing enabled + the variables below)
OCR_PROVIDER=""

# --- Google Cloud Document AI (only when OCR_PROVIDER=google) ---
# Path to a service-account JSON file kept outside Git (e.g. credentials/).
GOOGLE_APPLICATION_CREDENTIALS="credentials/google-service-account.json"
DOCUMENT_AI_PROJECT_ID="your-gcp-project-id"
DOCUMENT_AI_LOCATION="us"
DOCUMENT_AI_PROCESSOR_ID="your-processor-id"

# --- Local testing only ---
# Supabase auth user ID used by scripts/test-pipeline.ts.
TEST_USER_ID=""
